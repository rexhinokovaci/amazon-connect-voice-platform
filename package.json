{
  "name": "amazon-connect-voice-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of an enterprise Amazon Connect voice estate: IVR flows as code, Lex V2, Lambda fulfilment, Nova Sonic speech-to-speech, multi-tenant config and Datadog observability.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "flows:validate": "tsx scripts/validate-flows.ts",
    "synth": "cdk synth --quiet",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "sonic:demo": "tsx scripts/sonic-demo.ts",
    "check": "npm run build && npm run lint && npm run format:check && npm run flows:validate && npm test",
    "demo:build": "node demo/build.mjs",
    "demo:serve": "node demo/build.mjs && npx --yes http-server@14.1.1 site/demo -p 8080 -c-1",
    "docs:build": "mkdocs build --strict && node demo/build.mjs site/demo",
    "datadog:plan": "tsx scripts/datadog-apply.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@smithy/node-http-handler": "^4.12.1",
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1",
    "datadog-cdk-constructs-v2": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "aws-cdk": "^2.1146.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rexhinokovaci/amazon-connect-voice-platform.git"
  },
  "author": "Rexhino Kovaci"
}
